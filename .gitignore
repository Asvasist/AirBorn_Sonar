# Vivado generated files
*.jou
*.log
*.str
*.wdb
*.wcfg
*.pb
*.rpt
*.dcp
*.ltx

.cache/
.hw/
.ip_user_files/
.runs/
.sim/
.gen/
.Xil/

# Usually generated, do not commit unless needed as release artifact
*.bit

# Keep exported XSA
!hw/vivado/exports/*.xsa

# Vitis generated files
.metadata/
.build/
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.o
*.d
*.su

# Boot image release exception
!sw/boot_image/BOOT.BIN

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# -------------------------
# Vitis workspace generated content
# -------------------------
sw/vitis_workspace/**

# Keep only a placeholder/README so the folder exists in Git
!sw/vitis_workspace/
!sw/vitis_workspace/README.md
!sw/vitis_workspace/.gitkeep

# Do not track generated BSP/build/platform internals
**/bsp/
**/libsrc/
**/build_configs/
**/Debug/
**/Release/
**/.metadata/
**/.build/
**/compile_commands.json
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/build.ninja
**/*.elf
**/*.o
**/*.a
**/*.map
**/*.bin